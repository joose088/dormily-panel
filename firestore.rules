rules_version = '2';

// Solo las tres cuentas de Google del equipo pueden leer y escribir. Cualquier otra cuenta no ve nada.
// Cambia los correos (en minúsculas) y publica estas reglas en Firebase → Firestore Database → Reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    function esDelEquipo() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'correo-de-jose-carlos@gmail.com',
          'correo-de-alejandro@gmail.com',
          'correo-de-hugo@gmail.com'
        ];
    }

    match /{documento=**} {
      allow read, write: if esDelEquipo();
    }
  }
}
