rules_version = '2';

// Solo quien ha entrado con el código del equipo (la cuenta panel@dormily.es) puede leer y escribir.
// Copia este texto en Firebase → Firestore Database → Reglas y pulsa «Publicar».
service cloud.firestore {
  match /databases/{database}/documents {
    function esDelEquipo() {
      return request.auth != null
        && request.auth.token.email == 'panel@dormily.es';
    }

    match /{documento=**} {
      allow read, write: if esDelEquipo();
    }
  }
}
